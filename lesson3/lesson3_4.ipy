     "text": [
      "1\n",
      "=====猜數字遊戲=====\n",
      "\n",
      "猜對了，答案是:1\n",
      "您猜了1\n"
     ]
    }
   ],
   "source": [
    "import random\n",
    "\n",
    "def play_game():\n",
    "        min = 1\n",
    "        max = 100\n",
    "        count = 0        \n",
    "        target = random.randint(min,max)\n",
    "        print(target)\n",
    "        print(\"=====猜數字遊戲=====\\n\")     \n",
    "        while(True):     \n",
    "            keyin = int(input(f\"猜數字範圍{min}到{max}之間的數字:\"))\n",
    "            count += 1\n",
    "            if keyin >= min and keyin <= max:\n",
    "                if target == keyin:\n",
    "                    print(f\"猜對了，答案是:{target}\")\n",
    "                    print(f\"您猜了{count}\")\n",
    "                    break\n",
    "                elif (keyin > target):\n",
    "                    print(\"太大，再小一點\")\n",
    "                    max = keyin - 1\n",
    "                elif (keyin < target):\n",
    "                    print(\"太小，再大一點\")\n",
    "                    min = keyin + 1\n",
    "                print(f\"你已經猜了{count}次\")\n",
    "                \n",
    "            else:\n",
    "                print(\"請輸入提示範圍內的數字\")\n",
    "\n",
    "def main():\n",
    "    while(True):\n",
    "        play_game()    \n",
    "        is_play_again = input(\"您還要繼續嗎?y,n\")\n",
    "        if is_play_again == 'n':\n",
    "            break\n",
    "        \n",
    "\n",
    "        print(\"遊戲結束\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main() "
   ]
  }
 ],
